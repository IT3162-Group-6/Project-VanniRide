PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/vanniRideDB
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# OSRM-compatible routing service. The public server is suitable for development
# and demonstrations; use a controlled provider for a deployed application.
ROUTING_BASE_URL=https://router.project-osrm.org
ROUTING_PROFILE=driving
ROUTING_ALTERNATIVES=3
ROUTING_TIMEOUT_MS=5000
CANCELLATION_SWEEP_INTERVAL_MS=30000

# Required only when running: npm run seed:admin
ADMIN_NAME=Vanni Ride Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=0700000000
ADMIN_PASSWORD=replace_with_a_strong_password
