PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/vanniRideDB
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Public registration is restricted to this university domain. The testing
# bypass is available only outside production and should be disabled when
# testing the release behavior.
UNIVERSITY_EMAIL_DOMAIN=stu.vau.ac.lk
ALLOW_NON_UNIVERSITY_EMAILS=true

# Comma-separated frontend origins. This is mandatory in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Use osrm-nominatim only for local development. Production validation requires
# openrouteservice because public Nominatim forbids autocomplete usage.
MAP_PROVIDER=osrm-nominatim
OPENROUTESERVICE_BASE_URL=https://api.openrouteservice.org
OPENROUTESERVICE_API_KEY=
OPENROUTESERVICE_PROFILE=driving-car

# Local-development fallback provider settings.
ROUTING_BASE_URL=https://router.project-osrm.org
ROUTING_PROFILE=driving
ROUTING_ALTERNATIVES=3
ROUTING_TIMEOUT_MS=5000

# Nominatim-compatible local fallback. Do not deploy autocomplete with it.
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=VanniRide/1.0 (replace-with-team-contact)
GEOCODING_CONTACT=
GEOCODING_MIN_INTERVAL_MS=1000
GEOCODING_TIMEOUT_MS=5000
GEOCODING_CACHE_TTL_MS=86400000
GEOCODING_RESULT_LIMIT=5

CANCELLATION_SWEEP_INTERVAL_MS=30000

# Optional future email recovery. The current workflow uses admin-assisted resets.
FRONTEND_URL=http://localhost:5173
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=no-reply@example.com
PASSWORD_RESET_EXPIRES_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60

# Required only when running: npm run seed:admins
# Keep real administrator passwords in the deployment secret manager, never Git.
ADMIN_1_NAME=Vanni Ride Administrator 1
ADMIN_1_EMAIL=admin1@vau.ac.lk
ADMIN_1_PHONE=0700000001
ADMIN_1_PASSWORD=replace_with_a_unique_strong_password
ADMIN_2_NAME=Vanni Ride Administrator 2
ADMIN_2_EMAIL=admin2@vau.ac.lk
ADMIN_2_PHONE=0700000002
ADMIN_2_PASSWORD=replace_with_a_different_strong_password
ADMIN_3_NAME=Vanni Ride Administrator 3
ADMIN_3_EMAIL=admin3@vau.ac.lk
ADMIN_3_PHONE=0700000003
ADMIN_3_PASSWORD=replace_with_a_third_strong_password
