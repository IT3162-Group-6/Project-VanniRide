# Set this to the public HTTPS backend URL for production builds.
VITE_API_URL=http://localhost:5000/api

# Authentication is connected to the real API by default. Set this only when
# intentionally demonstrating the old browser-only accounts.
VITE_USE_MOCK_AUTH=false

# Optional browser-only demonstration mode. Keep disabled for the integrated
# application. If enabled, also enable VITE_USE_MOCK_AUTH.
VITE_USE_MOCK_DATA=false

# OpenStreetMap tile display settings. Attribution must remain visible.
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
VITE_MAP_INITIAL_LAT=8.7514
VITE_MAP_INITIAL_LON=80.4971
